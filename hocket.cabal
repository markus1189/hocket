cabal-version:       3.0
-- Initial hocket.cabal generated by cabal init.  For further
-- documentation, see http://haskell.org/cabal/users-guide/

name:                hocket
version:             0.2.0.0
-- synopsis:
-- description:
license:             BSD-3-Clause
license-file:        LICENSE
author:              Markus Hauck
maintainer:          markus1189@gmail.com
-- copyright:
-- category:
build-type:          Simple

-- The functional core (plan §4.1): domain and application, pure. No brick,
-- servant, network or async here, so the build rejects an import of them.
library core
  ghc-options:         -Wall -Wunused-packages -Werror
  hs-source-dirs:      src/core
  exposed-modules:     Hocket.Agent.Intent
                     , Hocket.Agent.Protocol
                     , Hocket.Agent.Snapshot
                     , Hocket.App.Batch
                     , Hocket.App.Effect
                     , Hocket.App.Model
                     , Hocket.App.Msg
                     , Hocket.App.Nav
                     , Hocket.App.Plan
                     , Hocket.App.Sync
                     , Hocket.App.Update
                     , Hocket.Domain.Bookmark
                     , Hocket.Domain.Filter
                     , Hocket.Domain.Reminder
  build-depends:       aeson
                     , base
                     , containers
                     , lens
                     , mtl
                     , sorted-list
                     , text
                     , time
                     , vector

-- Ports, adapters and the shell: everything that does IO.
library
  ghc-options:         -Wall -Wunused-packages -Werror
  hs-source-dirs:      src
  exposed-modules:     Hocket.Adapter.Fake
                     , Hocket.Adapter.Raindrop
                     , Hocket.Adapter.Raindrop.Api
                     , Hocket.Adapter.System
                     , Hocket.Port
                     , Hocket.Shell.Agent.Client
                     , Hocket.Shell.Agent.Server
                     , Hocket.Shell.Config
                     , Hocket.Shell.Fixture
                     , Hocket.Shell.Headless
                     , Hocket.Shell.Interpret
                     , Hocket.Shell.Signals
                     , Hocket.Shell.Tui.App
                     , Hocket.Shell.Tui.Keymap
                     , Hocket.Shell.Tui.View
                     , Hocket.Shell.Tui.Reconcile
                     , Hocket.Shell.Worker
  build-depends:       aeson
                     , async
                     , base
                     , brick
                     , bytestring
                     , case-insensitive
                     , containers
                     , dhall
                     , directory
                     , exceptions
                     , filepath
                     , hocket:core
                     , http-client-tls
                     , http-types
                     , lens
                     , monad-logger
                     , monad-loops
                     , network
                     , optparse-applicative
                     , process
                     , retry
                     , servant
                     , servant-client
                     , servant-client-core
                     , stm
                     , text
                     , text-zipper
                     , time
                     , unix
                     , vector
                     , vty
                     , formatting
                     , network-uri
                     , vty-unix

executable hocket
  ghc-options:         -Wall -Wunused-packages -threaded -Werror
  main-is:             hocket.hs
  hs-source-dirs:      main
  build-depends:       base
                     , bytestring
                     , dhall
                     , directory
                     , filepath
                     , hocket
                     , hocket:core
                     , lens
                     , monad-logger
                     , exceptions
                     , optparse-applicative
                     , text
                     , time


test-suite test
  default-language:    Haskell2010
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test
  main-is:             test.hs
  other-modules:       BatchTests
                     , CharacterizationTests
                     , ClassifyTests
                     , FakeTests
                     , FixtureTests
                     , Gen
                     , HeadlessTests
                     , IntentTests
                     , KeyIntentTests
                     , NavTests
                     , PlanTests
                     , Properties
                     , ReminderTests
                     , SMFixtureTests
                     , SnapshotGoldenTests
                     , SystemTests
                     , UpdateTests
                     , VisibleTests
                     , WorkerTests
  build-depends:       base
                     , aeson
                     , async
                     , brick
                     , bytestring
                     , case-insensitive
                     , containers
                     , directory
                     , exceptions
                     , filepath
                     , hedgehog
                     , hocket
                     , hocket:core
                     , http-media
                     , http-types
                     , lens
                     , monad-loops
                     , mtl
                     , network
                     , optparse-applicative
                     , servant-client-core
                     , process
                     , stm
                     , unix
                     , tasty
                     , tasty-golden
                     , tasty-hunit
                     , tasty-hedgehog
                     , temporary
                     , text
                     , text-zipper
                     , time
                     , vector
                     , vty

benchmark bench
  default-language:    Haskell2010
  type:                exitcode-stdio-1.0
  ghc-options:         -Wall -Wunused-packages -Werror -O2 -rtsopts "-with-rtsopts=-A32m"
  hs-source-dirs:      bench
  main-is:             Bench.hs
  build-depends:       base
                     , brick
                     , deepseq
                     , hocket
                     , hocket:core
                     , lens
                     , tasty-bench
                     , text
                     , time
