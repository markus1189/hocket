-- Initial hocket.cabal generated by cabal init.  For further
-- documentation, see http://haskell.org/cabal/users-guide/

name:                hocket
version:             0.2.0.0
-- synopsis:
-- description:
license:             BSD3
license-file:        LICENSE
author:              Markus Hauck
maintainer:          markus1189@gmail.com
-- copyright:
-- category:
build-type:          Simple
cabal-version:       >=1.8

library
  ghc-options:         -Wall -Wunused-packages -Werror
  hs-source-dirs:      src
  exposed-modules:     Network.Raindrop
                     , Network.Bookmark.Batch
                     , Network.Raindrop.Api
                     , Network.Bookmark.Agent.Protocol
                     , Network.Bookmark.Agent.Snapshot
                     , Network.Bookmark.Types
                     , Network.Bookmark.Ui.State
                     , Network.Bookmark.Ui.Sync
                     , Network.Bookmark.Ui.Widgets
  Build-depends:       aeson
                     , base
                     , brick
                     , containers
                     , dhall
                     , http-client-tls
                     , http-types
                     , lens
                     , monad-logger
                     , mtl
                     , retry
                     , servant
                     , servant-client
                     , sorted-list
                     , text
                     , text-zipper
                     , time
                     , vector

executable hocket
  ghc-options:         -Wall -Wunused-packages -threaded -Werror
  main-is:             hocket.hs
  hs-source-dirs:      main
  other-modules:       AgentClient
                     , AgentServer
                     , Events
                     , Keys
                     , Worker
  build-depends:       aeson
                     , async
                     , base
                     , brick
                     , bytestring
                     , case-insensitive
                     , containers
                     , dhall
                     , directory
                     , filepath
                     , formatting
                     , hocket
                     , http-types
                     , lens
                     , monad-logger
                     , monad-loops
                     , exceptions
                     , network
                     , network-uri
                     , optparse-applicative
                     , process
                     , servant-client
                     , servant-client-core
                     , stm
                     , text
                     , text-zipper
                     , time
                     , unix
                     , vector
                     , vty-unix
                     , vty


test-suite test
  default-language:    Haskell2010
  type:                exitcode-stdio-1.0
  hs-source-dirs:      test, main
  main-is:             test.hs
  other-modules:       AgentClient
                     , AgentServer
                     , BatchTests
                     , CharacterizationTests
                     , ClassifyTests
                     , Events
                     , Gen
                     , Keys
                     , Worker
                     , Properties
                     , WorkerTests
  build-depends:       base
                     , aeson
                     , async
                     , brick
                     , bytestring
                     , case-insensitive
                     , containers
                     , directory
                     , exceptions
                     , filepath
                     , hedgehog
                     , hocket == 0.2.0.0
                     , http-media
                     , http-types
                     , lens
                     , mtl
                     , network
                     , servant-client-core
                     , stm
                     , unix
                     , tasty
                     , tasty-golden
                     , tasty-hunit
                     , tasty-hedgehog
                     , temporary
                     , text
                     , text-zipper
                     , time
                     , vector

benchmark bench
  default-language:    Haskell2010
  type:                exitcode-stdio-1.0
  ghc-options:         -Wall -Wunused-packages -Werror -O2 -rtsopts "-with-rtsopts=-A32m"
  hs-source-dirs:      bench
  main-is:             Bench.hs
  build-depends:       base
                     , brick
                     , deepseq
                     , hocket
                     , lens
                     , tasty-bench
                     , text
                     , time
